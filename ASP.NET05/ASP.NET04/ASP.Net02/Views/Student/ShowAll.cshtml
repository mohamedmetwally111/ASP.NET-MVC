@model StudentListViewModel
@{
    ViewData["Title"] = "ShowAll";
    Layout = "_Mylayout";
}

<div class="container mt-4">
    <h1 class="mb-4" style="color: white;">Students List</h1>

    <div class="row mb-4">
        <div class="col-md-10">
            <form method="get" action="/Student/ShowAll" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name..." />
                </div>
                <div class="col-md-4">
                    <select name="deptId" asp-items="Model.DeptList" class="form-control">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">Search & Filter</button>
                    <a href="/Student/ShowAll" class="btn btn-secondary">Reset</a>
                </div>
            </form>
        </div>
        <div class="col-md-2 text-end">
            <a href="/Student/Add" class="btn btn-success">New Student</a>
        </div>
    </div>

    <table class="table table-hover" style="color:white">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Id</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Students)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Id</td>
                    <td>@(item.Departments?.Name ?? "N/A")</td>
                    <td>
                        <a href="/Student/Edit/@item.Id" class="btn btn-sm btn-info">Edit</a>
                        <a href="/Student/Delete/@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Student/ShowAll?search=@Model.SearchTerm&deptId=@Model.SelectedDeptId&page=@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/Student/ShowAll?search=@Model.SearchTerm&deptId=@Model.SelectedDeptId&page=@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="/Student/ShowAll?search=@Model.SearchTerm&deptId=@Model.SelectedDeptId&page=@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
